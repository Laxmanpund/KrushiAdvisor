
<% layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="text-center py-5">
        <div class="mb-4">
            <i class="fa-solid fa-seedling text-success"
               style="font-size: 4rem;"></i>
        </div>

        <h1 class="display-1 fw-bold text-success">
            <%= statusCode || 404 %>
        </h1>

        <h2 class="mb-3">
            <%= statusCode === 404
                ? "पान सापडले नाही!"
                : "काहीतरी चूक झाली!" %>
        </h2>

        <p class="text-muted fs-5">
            <%= message || "तुम्ही शोधत असलेले पान उपलब्ध नाही." %>
        </p>

        <a href="/" class="btn btn-success btn-lg mt-3">
            <i class="fa-solid fa-house me-2"></i>
            मुख्यपृष्ठावर जा
        </a>
    </div>
</div>
