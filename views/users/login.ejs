<% layout("/layouts/boilerplate") %>

<section class="auth-section">
    <div class="container">

        <div class="auth-card">
            <div class="auth-heading text-center">
                <div class="auth-icon">
                    <i class="fa-solid fa-right-to-bracket"></i>
                </div>

                <h1>लॉगिन करा</h1>
                <p>Krushi Advisor मध्ये तुमच्या खात्यात प्रवेश करा.</p>
            </div>

            <form action="/login" method="POST">
                <div class="mb-3">
                    <label for="email" class="form-label">ई-मेल</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="example@email.com" required>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">पासवर्ड</label>
                    <input type="password" id="password" name="password" class="form-control" placeholder="तुमचा पासवर्ड" required>
                </div>

                <button type="submit" class="btn btn-success w-100">
                    लॉगिन करा
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>

            <div class="auth-footer text-center">
                <p>
                    खाते नाही?
                    <a href="/signup">
                        नोंदणी करा
                    </a>
                </p>
            </div>

        </div>
    </div>
</section>