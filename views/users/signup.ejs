<% layout("/layouts/boilerplate") %>

<section class="auth-section">
    <div class="container">

        <div class="auth-card">
            <div class="auth-heading text-center">

                <div class="auth-icon">
                    <i class="fa-solid fa-user-plus"></i>
                </div>

                <h1>नोंदणी करा</h1>
                <p>Krushi Advisor वर तुमचे खाते तयार करा.</p>
            </div>

            <form action="/signup" method="POST">
                <div class="mb-3">
                    <label for="name" class="form-label">पूर्ण नाव</label>
                    <input type="text" id="name" name="name" class="form-control" placeholder="तुमचे नाव" required>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">ई-मेल</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="example@email.com" required>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">पासवर्ड</label>
                    <input type="password" id="password" name="password" class="form-control" placeholder="पासवर्ड तयार करा" required>
                </div>

                <div class="mb-3">
                    <label for="confirmPassword" class="form-label">पासवर्ड पुन्हा लिहा</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="पासवर्ड पुन्हा लिहा" required>
                </div>

                <div class="mb-3">
                    <label for="role" class="form-label">तुम्ही कोणत्या प्रकारचे वापरकर्ता आहात?</label>
                    <select id="role" name="role" class="form-select">
                        <option value="farmer" selected>शेतकरी</option>
                        <option value="advisor">कृषी सल्लागार</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-success w-100">
                    खाते तयार करा
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>

            <div class="auth-footer text-center">
                <p>
                    आधीपासून खाते आहे?
                    <a href="/login">लॉगिन करा</a>
                </p>
            </div>

        </div>
    </div>
</section>