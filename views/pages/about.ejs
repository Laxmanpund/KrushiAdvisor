<% layout("/layouts/boilerplate") %>

<section class="about-hero">
    <div class="container">
        <div class="about-hero-content text-center">
            <span class="about-badge">
                <i class="fa-solid fa-seedling"></i>
                About Krushi Advisor
            </span>

            <h1>Empowering Farmers with Better Agricultural Guidance</h1>

            <p>
                Krushi Advisor is an agriculture-focused platform designed to
                make useful farming information and expert guidance easier to access.
            </p>
        </div>
    </div>
</section>


<section class="about-intro">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-lg-6">
                <div class="about-icon-box">
                    <i class="fa-solid fa-wheat-awn"></i>
                </div>
            </div>

            <div class="col-lg-6">
                <span class="section-label">OUR PLATFORM</span>

                <h2>What is Krushi Advisor?</h2>

                <p>
                    Krushi Advisor is a platform created to help farmers
                    access agricultural information in a simple and organized way.
                </p>

                <p>
                    Farmers can explore crop information, learn about common
                    diseases and pests, and find agriculture advisors based on
                    their requirements.
                </p>

                <p>
                    Our goal is to bring important agricultural resources
                    together in one easy-to-use platform.
                </p>
            </div>

        </div>
    </div>
</section>

<section class="about-services">
    <div class="container">

        <div class="text-center mb-5">
            <span class="section-label">WHAT WE PROVIDE</span>
            <h2>Everything in One Place</h2>

            <p class="section-description">
                Explore the key features of Krushi Advisor.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="about-service-card">

                    <div class="about-service-icon">
                        <i class="fa-solid fa-seedling"></i>
                    </div>

                    <h3>Crop Guidance</h3>

                    <p>
                        Explore crop-wise information including soil,
                        irrigation, sowing, harvesting and other
                        important cultivation details.
                    </p>

                </div>
            </div>

            <div class="col-md-4">
                <div class="about-service-card">

                    <div class="about-service-icon">
                        <i class="fa-solid fa-bug"></i>
                    </div>

                    <h3>Disease & Pest Information</h3>
                    <p>
                        Learn about common crop diseases and pests,
                        their symptoms and general preventive guidance.
                    </p>

                </div>
            </div>

            <div class="col-md-4">
                <div class="about-service-card">

                    <div class="about-service-icon">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>

                    <h3>Find an Advisor</h3>
                    <p>
                        Discover agriculture advisors based on their
                        expertise, experience and areas of guidance.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="about-mission">
    <div class="container">

        <div class="mission-box text-center">
            <div class="mission-icon">
                <i class="fa-solid fa-bullseye"></i>
            </div>

            <span class="section-label">OUR MISSION</span>
            <h2>Making Agricultural Knowledge Easier to Access</h2>
            <p>
                Our mission is to make useful agricultural knowledge easier
                to find and help farmers connect with suitable agricultural
                guidance when they need it.
            </p>
        </div>

    </div>
</section>

<section class="about-process">
    <div class="container">

        <div class="text-center mb-5">
            <span class="section-label">HOW IT WORKS</span>
            <h2>How Krushi Advisor Helps</h2>
        </div>

        <div class="row g-4">

            <div class="col-md-3">
                <div class="process-card">
                    <span>01</span>
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <h3>Explore</h3>
                    <p>
                        Find information about crops and farming topics.
                    </p>
                </div>
            </div>


            <div class="col-md-3">
                <div class="process-card">
                    <span>02</span>
                    <i class="fa-solid fa-bug"></i>
                    <h3>Understand</h3>
                    <p>
                        Learn about common diseases and pests affecting crops.
                    </p>
                </div>
            </div>


            <div class="col-md-3">
                <div class="process-card">
                    <span>03</span>
                    <i class="fa-solid fa-user-tie"></i>
                    <h3>Find Advisor</h3>
                    <p>
                        Find an agriculture advisor based on your needs.
                    </p>
                </div>
            </div>


            <div class="col-md-3">
                <div class="process-card">
                    <span>04</span>
                    <i class="fa-solid fa-comments"></i>
                    <h3>Get Guidance</h3>
                    <p>
                        Connect with an advisor for agricultural guidance.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="about-vision">
    <div class="container">

        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="section-label">FUTURE VISION</span>
                <h2>Building a Smarter Agriculture Platform</h2>
                <p>
                    Krushi Advisor is designed to grow beyond basic
                    agricultural information.
                </p>

                <p>
                    Future versions of the platform can include online
                    consultation booking, farmer and advisor accounts,
                    reviews, personalized recommendations and
                    AI-assisted agricultural tools.
                </p>
            </div>

            <div class="col-lg-6">
                <div class="vision-card">
                    <div>
                        <i class="fa-solid fa-calendar-check"></i>
                        <span>Online Consultation</span>
                    </div>

                    <div>
                        <i class="fa-solid fa-star"></i>
                        <span>Advisor Reviews</span>
                    </div>

                    <div>
                        <i class="fa-solid fa-user"></i>
                        <span>Farmer & Advisor Accounts</span>
                    </div>

                    <div>
                        <i class="fa-solid fa-robot"></i>
                        <span>AI-assisted Agriculture Tools</span>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<section class="about-cta">
    <div class="container">

        <div class="cta-box text-center">
            <i class="fa-solid fa-leaf"></i>
            <h2>Ready to Explore Krushi Advisor?</h2>
            <p>Explore crop information or find an agriculture advisor.</p>

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="/crops" class="btn btn-success">
                    <i class="fa-solid fa-seedling"></i>
                    Explore Crops
                </a>

                <a href="/advisors" class="btn btn-outline-success">
                    <i class="fa-solid fa-user-tie"></i>
                    Find an Advisor
                </a>
            </div>

        </div>
    </div>
</section>