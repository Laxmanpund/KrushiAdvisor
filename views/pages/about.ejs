<% layout("/layouts/boilerplate") %>

<section class="about-hero">
    <div class="container">
        <div class="about-hero-content text-center">
            <span class="about-badge">
                <i class="fa-solid fa-seedling"></i>
                Krushi Advisor बद्दल
            </span>
            <h1>शेतकऱ्यांना योग्य कृषी मार्गदर्शन मिळवून देण्यासाठी एक डिजिटल व्यासपीठ</h1>
            <p>
                Krushi Advisor हे शेतीशी संबंधित उपयुक्त माहिती आणि
                कृषी तज्ज्ञांचे मार्गदर्शन शेतकऱ्यांपर्यंत सोप्या पद्धतीने
                पोहोचवण्यासाठी तयार केलेले व्यासपीठ आहे.
            </p>
        </div>
    </div>
</section>


<section class="about-intro">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-lg-6">
                <div class="about-icon-box">
                    <i class="fa-solid fa-wheat-awn"></i>
                </div>
            </div>

            <div class="col-lg-6">
                <span class="section-label">आमचे व्यासपीठ</span>
                <h2>Krushi Advisor म्हणजे काय?</h2>
                <p>
                    Krushi Advisor हे शेतकऱ्यांना शेतीशी संबंधित माहिती
                    सोप्या आणि व्यवस्थित पद्धतीने मिळवून देण्यासाठी तयार
                    केलेले डिजिटल व्यासपीठ आहे.
                </p>
                <p>
                    येथे शेतकरी विविध पिकांची माहिती पाहू शकतात,
                    पिकांवरील सामान्य रोग व किडींबद्दल जाणून घेऊ शकतात
                    आणि त्यांच्या गरजेनुसार कृषी सल्लागार शोधू शकतात.
                </p>
                <p>
                    शेतीसाठी आवश्यक असलेली महत्त्वाची माहिती
                    एकाच ठिकाणी उपलब्ध करून देणे हे आमचे उद्दिष्ट आहे.
                </p>
            </div>

        </div>
    </div>
</section>


<section class="about-services">
    <div class="container">

        <div class="text-center mb-5">
            <span class="section-label">आम्ही काय उपलब्ध करून देतो?</span>
            <h2>शेतीसाठी आवश्यक माहिती एकाच ठिकाणी</h2>
            <p class="section-description">
                Krushi Advisor वरील प्रमुख सुविधा जाणून घ्या.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="about-service-card">

                    <div class="about-service-icon">
                        <i class="fa-solid fa-seedling"></i>
                    </div>

                    <h3>पिकांचे मार्गदर्शन</h3>
                    <p>
                        विविध पिकांबद्दल माती, सिंचन, पेरणी,
                        काढणी आणि लागवडीशी संबंधित महत्त्वाची
                        माहिती जाणून घ्या.
                    </p>
                </div>
            </div>


            <div class="col-md-4">
                <div class="about-service-card">

                    <div class="about-service-icon">
                        <i class="fa-solid fa-bug"></i>
                    </div>
                    <h3>रोग व किडींची माहिती</h3>
                    <p>
                        पिकांवर आढळणारे सामान्य रोग व किडी,
                        त्यांची लक्षणे आणि सामान्य प्रतिबंधात्मक
                        उपायांबद्दल माहिती मिळवा.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="about-service-card">

                    <div class="about-service-icon">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>

                    <h3>कृषी सल्लागार शोधा</h3>
                    <p>
                        सल्लागारांचे कौशल्य, अनुभव आणि
                        मार्गदर्शनाच्या क्षेत्रानुसार योग्य
                        कृषी सल्लागार शोधा.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


<section class="about-mission">
    <div class="container">

        <div class="mission-box text-center">

            <div class="mission-icon">
                <i class="fa-solid fa-bullseye"></i>
            </div>

            <span class="section-label">आमचे ध्येय</span>
            <h2>कृषीविषयक माहिती शेतकऱ्यांपर्यंत सोप्या पद्धतीने पोहोचवणे</h2>
            <p>
                उपयुक्त कृषी माहिती सहज उपलब्ध करून देणे आणि
                शेतकऱ्यांना त्यांच्या गरजेनुसार योग्य कृषी मार्गदर्शन
                मिळवून देण्यासाठी मदत करणे हे आमचे ध्येय आहे.
            </p>
        </div>
    </div>
</section>


<section class="about-process">
    <div class="container">

        <div class="text-center mb-5">
            <span class="section-label">हे कसे कार्य करते?</span>
