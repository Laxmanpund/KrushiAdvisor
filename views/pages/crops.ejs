<% layout("/layouts/boilerplate") %>

<section class="crops-section">
    <div class="container">

        <!-- Heading -->

        <div class="section-heading text-center">

            <p class="section-subtitle">CROP GUIDE</p>

            <h1>Explore Crops</h1>
            <p class="section-description">
                Explore information about different crops,
                their growing season, soil requirements and farming practices.
            </p>

        </div>


        <!-- Search -->

        <div class="crop-search">

            <div class="input-group">

                <input type="text" class="form-control" placeholder="Search for a crop...">
                <button class="btn btn-success">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Search
                </button>

            </div>

        </div>


        <!-- Categories -->

        <div class="crop-filters text-center">

            <button class="btn btn-success">
                All
            </button>

            <button class="btn btn-outline-success">
                Kharif
            </button>

            <button class="btn btn-outline-success">
                Rabi
            </button>

            <button class="btn btn-outline-success">
                Cash Crops
            </button>

        </div>


        <!-- Crop Cards -->

        <div class="row g-4 mt-4">


            <!-- Wheat -->

            <div class="col-md-6 col-lg-4">

                <div class="crop-card">

                    <div class="crop-image">
                        <i class="fa-solid fa-wheat-awn"></i>
                    </div>

                    <div class="crop-content">
                        <span class="crop-category">Rabi Crop</span>
                        <h3>Wheat</h3>
                        <p>
                            Learn about wheat cultivation,
                            soil, irrigation and harvesting.
                        </p>
                        <a href="/crops/wheat">View Details<i class="fa-solid fa-arrow-right"></i></a>
                    </div>

                </div>
            </div>


            <!-- Cotton -->

            <div class="col-md-6 col-lg-4">

                <div class="crop-card">
                    <div class="crop-image">
                        <i class="fa-solid fa-seedling"></i>
                    </div>

                    <div class="crop-content">
                        <span class="crop-category">Kharif Crop</span>
                        <h3>Cotton</h3>
                        <p>
                            Explore cotton cultivation and
                            important crop management practices.
                        </p>
                        <a href="/crops/cotton">View Details<i class="fa-solid fa-arrow-right"></i></a>

                    </div>
                </div>

            </div>


            <!-- Soybean -->

            <div class="col-md-6 col-lg-4">

                <div class="crop-card">
                    <div class="crop-image">
                        <i class="fa-solid fa-leaf"></i>
                    </div>

                    <div class="crop-content">
                        <span class="crop-category">Kharif Crop</span>
                        <h3>Soybean</h3>
                        <p>
                            Learn about soybean soil,
                            sowing and irrigation requirements.
                        </p>
                        <a href="/crops/soybean">View Details<i class="fa-solid fa-arrow-right"></i></a>
                    </div>

                </div>
            </div>


            <!-- Rice -->

            <div class="col-md-6 col-lg-4">

                <div class="crop-card">
                    <div class="crop-image">
                        <i class="fa-solid fa-bowl-rice"></i>
                    </div>

                    <div class="crop-content">
                        <span class="crop-category">Kharif Crop</span>
                        <h3>Rice</h3>
                        <p>
                            Explore rice cultivation and
                            water management practices.
                        </p>
                        <a href="/crops/rice">View Details<i class="fa-solid fa-arrow-right"></i></a>
                    </div>

                </div>
            </div>

        </div>
    </div>

</section>