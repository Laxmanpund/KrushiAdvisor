<% layout("/layouts/boilerplate") %>

<section class="crops-section">
    <div class="container">

        <div class="section-heading text-center">
            <p class="section-subtitle">पीक मार्गदर्शक</p>
            <h1>पिकांची माहिती</h1>
            <p class="section-description">
                विविध पिकांची लागवड, हंगाम, मातीची आवश्यकता
                आणि शेती पद्धतींबद्दल माहिती जाणून घ्या.
            </p>
        </div>

        <div class="crop-search">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="पीक शोधा...">
                <button class="btn btn-success">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    शोधा
                </button>
            </div>
        </div>

        <div class="crop-filters text-center">
            <button class="btn btn-success">सर्व</button>
            <button class="btn btn-outline-success">खरीप</button>
            <button class="btn btn-outline-success">रब्बी</button>
            <button class="btn btn-outline-success">नगदी पिके</button>
        </div>

        <div class="row g-4 mt-4">
            <% crops.forEach(crop => { %>

                <div class="col-md-6 col-lg-4">
                    <div class="crop-card">
                        <div class="crop-image">
                            <% if (crop.name === "गहू") { %>
                                <i class="fa-solid fa-wheat-awn"></i>
                            <% } else if (crop.name === "कापूस") { %>
                                <i class="fa-solid fa-seedling"></i>
                            <% } else if (crop.name === "सोयाबीन") { %>
                                <i class="fa-solid fa-leaf"></i>
                            <% } else if (crop.name === "भात") { %>
                                <i class="fa-solid fa-bowl-rice"></i>
                            <% } else { %>
                                <i class="fa-solid fa-seedling"></i>
                            <% } %>
                        </div>

                        <div class="crop-content">
                            <span class="crop-category"><%= crop.category %></span>
                            <h3><%= crop.name %></h3>
                            <p>
                                <%= crop.name %>
                                पिकासाठी माती, सिंचन, पेरणी,
                                खत व्यवस्थापन आणि काढणीबद्दल
                                माहिती जाणून घ्या.
                            </p>
                            <a href="/crops/<%= crop._id %>">
                                अधिक माहिती
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

            <% }) %>

        </div>
    </div>
</section>