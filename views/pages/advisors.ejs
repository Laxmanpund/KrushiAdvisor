<% layout("/layouts/boilerplate") %>

<section class="advisors-section">
    <div class="container">

        <div class="section-heading text-center">
            <p class="section-subtitle">कृषी तज्ज्ञ</p>
            <h1>कृषी सल्लागार शोधा</h1>
            <p class="section-description">
                सल्लागारांचे कौशल्य, अनुभव आणि सल्ला सेवेनुसार
                योग्य कृषी सल्लागार शोधा.
            </p>
        </div>

        <div class="advisor-search">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="सल्लागार किंवा कौशल्य शोधा...">
                <button class="btn btn-success">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    शोधा
                </button>
            </div>
        </div>

        <div class="advisor-filters">
            <select class="form-select">
                <option selected>ठिकाण</option>
                <option>महाराष्ट्र</option>
                <option>मध्य प्रदेश</option>
                <option>कर्नाटक</option>
            </select>

            <select class="form-select">
                <option selected>कौशल्य</option>
                <option>पीक व्यवस्थापन</option>
                <option>वनस्पती रोग</option>
                <option>मृदा विज्ञान</option>
                <option>माती व्यवस्थापन</option>
                <option>कीड व्यवस्थापन</option>
                <option>सिंचन व्यवस्थापन</option>
            </select>

            <select class="form-select">
                <option selected>अनुभव</option>
                <option>1+ वर्षे</option>
                <option>5+ वर्षे</option>
                <option>10+ वर्षे</option>
            </select>

            <select class="form-select">
                <option selected>सल्ला शुल्क</option>
                <option>₹500 पेक्षा कमी</option>
                <option>₹500 - ₹1000</option>
                <option>₹1000 पेक्षा जास्त</option>
            </select>
        </div>

        <div class="advisor row g-4 mt-4">
            <% if (advisors.length > 0) { %>
                <% advisors.forEach(advisor => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="advisor-card">

                            <div class="advisor-photo">
                                <i class="fa-solid fa-user"></i>
                            </div>

                            <div class="advisor-content">
                                <span class="advisor-status">
                                    <% if (advisor.isAvailable) { %>
                                        <i class="fa-solid fa-circle"></i>
                                        उपलब्ध
                                    <% } else { %>
                                        <i class="fa-solid fa-circle"></i>
                                        सध्या अनुपलब्ध
                                    <% } %>
                                </span>

                                <h3><%= advisor.name %></h3>
                                <p class="advisor-qualification"><%= advisor.qualification %></p>

                                <div class="advisor-expertise">
                                    <% advisor.expertise.forEach(skill => { %>
                                        <span><%= skill %></span>
                                    <% }) %>
                                </div>

                                <div class="advisor-meta">
                                    <span>
                                        <i class="fa-solid fa-briefcase"></i>
                                        <%= advisor.experience %> वर्षे
                                    </span>
                                    <span>
                                        <i class="fa-solid fa-location-dot"></i>
                                        <%= advisor.location %>
                                    </span>
                                </div>

                                <div class="advisor-bottom">
                                    <span class="advisor-rating">
                                        <i class="fa-solid fa-star"></i>
                                        <%= advisor.rating %>
                                    </span>
                                    <strong>₹<%= advisor.consultationFee %> / सल्ला</strong>
                                </div>

                                <a href="/advisors/<%= advisor._id %>" class="btn btn-outline-success w-100 mt-3">प्रोफाइल पहा</a>
                            </div>
                        </div>
                    </div>
                <% }) %>

            <% } else { %>
                <div class="col-12">
                    <div class="text-center py-5">
                        <i class="fa-solid fa-user-slash fa-2x mb-3"></i>
                        <h3>सध्या कोणतेही सल्लागार उपलब्ध नाहीत.</h3>
                        <p>कृपया नंतर पुन्हा प्रयत्न करा.</p>
                    </div>
                </div>
            <% } %>

        </div>
    </div>
</section>