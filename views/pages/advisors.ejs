<% layout("/layouts/boilerplate") %>

<section class="advisors-section">
    <div class="container">

        <div class="section-heading text-center">
            <p class="section-subtitle">AGRICULTURE EXPERTS</p>
            <h1>Find an Agriculture Advisor</h1>
            <p class="section-description">
                Connect with agriculture advisors based on their
                expertise, experience and consultation services.
            </p>
        </div>

        <div class="advisor-search">

            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search advisor or expertise...">
                <button class="btn btn-success"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
            </div>
        </div>

        <div class="advisor-filters">
            <select class="form-select">
                <option selected>Location</option>
                <option>Maharashtra</option>
                <option>Madhya Pradesh</option>
                <option>Karnataka</option>
            </select>


            <select class="form-select">
                <option selected>Expertise</option>
                <option>Crop Management</option>
                <option>Plant Disease</option>
                <option>Soil Management</option>
                <option>Irrigation</option>
            </select>

            <select class="form-select">
                <option selected>Experience</option>
                <option>1+ Years</option>
                <option>5+ Years</option>
                <option>10+ Years</option>
            </select>

            <select class="form-select">
                <option selected>Consultation Fee</option>
                <option>
                    Under ₹500
                </option>
                <option>
                    ₹500 - ₹1000
                </option>
                <option>
                    Above ₹1000
                </option>
            </select>
        </div>

        <div class="advisor row g-4 mt-4">

            <!-- Advisor 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="advisor-card">

                    <div class="advisor-photo">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div class="advisor-content">
                        <span class="advisor-status">
                            <i class="fa-solid fa-circle"></i>
                            Available
                        </span>

                        <h3>Dr. Rajesh Patil</h3>
                        <p class="advisor-qualification">M.Sc. Agriculture</p>

                        <div class="advisor-expertise">
                            <span>Crop Management</span>
                            <span>Soil Science</span>
                        </div>

                        <div class="advisor-meta">
                            <span>
                                <i class="fa-solid fa-briefcase"></i>
                                8 Years
                            </span>
                            <span>
                                <i class="fa-solid fa-location-dot"></i>
                                Maharashtra
                            </span>
                        </div>

                        <div class="advisor-bottom">
                            <span class="advisor-rating">
                                <i class="fa-solid fa-star"></i>
                                4.8
                            </span>
                            <strong>₹500 / Consultation</strong>
                        </div>

                        <a href="/advisors/rajesh-patil" class="btn btn-outline-success w-100 mt-3">View Profile</a>
                    </div>
                </div>
            </div>


            <!-- Advisor 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="advisor-card">

                    <div class="advisor-photo">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div class="advisor-content">
                        <span class="advisor-status">
                            <i class="fa-solid fa-circle"></i>
                            Available
                        </span>

                        <h3>Dr. Priya Sharma</h3>
                        <p class="advisor-qualification">Ph.D. Plant Pathology</p>

                        <div class="advisor-expertise">
                            <span>Plant Disease</span>
                            <span>Pest Management</span>
                        </div>

                        <div class="advisor-meta">
                            <span>
                                <i class="fa-solid fa-briefcase"></i>
                                10 Years
                            </span>
                            <span>
                                <i class="fa-solid fa-location-dot"></i>
                                Maharashtra
                            </span>
                        </div>

                        <div class="advisor-bottom">
                            <span class="advisor-rating">
                                <i class="fa-solid fa-star"></i>
                                4.9
                            </span>
                            <strong>₹700 / Consultation</strong>
                        </div>

                        <a href="/advisors/priya-sharma" class="btn btn-outline-success w-100 mt-3">View Profile</a>
                    </div>
                </div>
            </div>


            <!-- Advisor 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="advisor-card">

                    <div class="advisor-photo">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div class="advisor-content">

                        <span class="advisor-status">
                            <i class="fa-solid fa-circle"></i>
                            Available
                        </span>

                        <h3>Dr. Amit Deshmukh</h3>
                        <p class="advisor-qualification">M.Sc. Soil Science</p>

                        <div class="advisor-expertise">
                            <span>Soil Management</span>
                            <span>Irrigation</span>
                        </div>

                        <div class="advisor-meta">
                            <span>
                                <i class="fa-solid fa-briefcase"></i>
                                6 Years
                            </span>
                            <span>
                                <i class="fa-solid fa-location-dot"></i>
                                Maharashtra
                            </span>
                        </div>

                        <div class="advisor-bottom">
                            <span class="advisor-rating">
                                <i class="fa-solid fa-star"></i>
                                4.7
                            </span>
                            <strong>₹400 / Consultation</strong>
                        </div>

                        <a href="/advisors/amit-deshmukh" class="btn btn-outline-success w-100 mt-3">View Profile</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>