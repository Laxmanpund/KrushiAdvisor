<% layout("/layouts/boilerplate") %>

<section class="advisors-section">
    <div class="container">

        <div class="section-heading text-center">
            <p class="section-subtitle">कृषी तज्ज्ञ</p>
            <h1>कृषी सल्लागार शोधा</h1>
            <p class="section-description">
                सल्लागारांचे कौशल्य, अनुभव आणि सल्ला सेवेनुसार
                योग्य कृषी सल्लागार शोधा.
            </p>
        </div>

        <form action="/advisors" method="GET">

            <div class="advisor-search">
                <div class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="सल्लागार किंवा कौशल्य शोधा..." value="<%= search || '' %>">
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        शोधा
                    </button>
                </div>
            </div>

            <div class="advisor-filters">

                <select name="location" class="form-select">
                    <option value="">सर्व ठिकाणे</option>
                    <option value="महाराष्ट्र"
                        <%= location === "महाराष्ट्र" ? "selected" : "" %>>
                        महाराष्ट्र
                    </option>
                </select>

                <select name="expertise" class="form-select">
                   <option value="">सर्व कौशल्ये</option>
                   <option value="पीक व्यवस्थापन"
                        <%= expertise === "पीक व्यवस्थापन" ? "selected" : "" %>>
                        पीक व्यवस्थापन
                   </option>

                   <option value="मृदा विज्ञान"
                        <%= expertise === "मृदा विज्ञान" ? "selected" : "" %>>
                        मृदा विज्ञान
                    </option>

                    <option value="सिंचन व्यवस्थापन"
                        <%= expertise === "सिंचन व्यवस्थापन" ? "selected" : "" %>>
                        सिंचन व्यवस्थापन
                   </option>

                   <option value="अन्नद्रव्य व्यवस्थापन"
                        <%= expertise === "अन्नद्रव्य व्यवस्थापन" ? "selected" : "" %>>
                        अन्नद्रव्य व्यवस्थापन
                   </option>

                   <option value="वनस्पती रोग"
                        <%= expertise === "वनस्पती रोग" ? "selected" : "" %>>
                        वनस्पती रोग
                   </option>

                   <option value="कीड व्यवस्थापन"
                        <%= expertise === "कीड व्यवस्थापन" ? "selected" : "" %>>
                        कीड व्यवस्थापन
                   </option>

                   <option value="माती व्यवस्थापन"
                        <%= expertise === "माती व्यवस्थापन" ? "selected" : "" %>>
                        माती व्यवस्थापन
                    </option>
                </select>

                <select name="experience" class="form-select">
                    <option value="">सर्व अनुभव</option>
                    <option value="1"
                        <%= experience === "1" ? "selected" : "" %>>
                        1+ वर्षे
                   </option> 
                   <option value="5"
                        <%= experience === "5" ? "selected" : "" %>>
                        5+ वर्षे
                   </option>
                   <option value="10"
                        <%= experience === "10" ? "selected" : "" %>>
                        10+ वर्षे
                    </option>
                </select>

                <select name="fee" class="form-select">
                    <option value="">सर्व शुल्क</option>
                    <option value="500"
                        <%= fee === "500" ? "selected" : "" %>>
                        ₹500 पेक्षा कमी
                    </option>

                    <option value="500-1000"
                        <%= fee === "500-1000" ? "selected" : "" %>>
                        ₹500 - ₹1000
                    </option>

                    <option value="1000"
                        <%= fee === "1000" ? "selected" : "" %>>
                        ₹1000 पेक्षा जास्त
                   </option>
                </select>
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" name="available" value="true" id="available" <%= available === "true" ? "checked" : "" %>>
                    <label class="form-check-label" for="available">फक्त उपलब्ध सल्लागार दाखवा</label>
                </div>
           </div>
       </form>

        <div class="advisor row g-4 mt-4">
            <% if (advisors.length > 0) { %>
                <% advisors.forEach(advisor => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="advisor-card">

                            <div class="advisor-photo">
                                <i class="fa-solid fa-user"></i>
                            </div>

                            <div class="advisor-content">
                                <span class="advisor-status">
                                    <% if (advisor.isAvailable) { %>
                                        <i class="fa-solid fa-circle"></i>
                                        उपलब्ध
                                    <% } else { %>
                                        <i class="fa-solid fa-circle"></i>
                                        सध्या अनुपलब्ध
                                    <% } %>
                                </span>

                                <h3><%= advisor.name %></h3>
                                <p class="advisor-qualification"><%= advisor.qualification %></p>

                                <div class="advisor-expertise">
                                    <% advisor.expertise.forEach(skill => { %>
                                        <span><%= skill %></span>
                                    <% }) %>
                                </div>

                                <div class="advisor-meta">
                                    <span>
                                        <i class="fa-solid fa-briefcase"></i>
                                        <%= advisor.experience %> वर्षे
                                    </span>
                                    <span>
                                        <i class="fa-solid fa-location-dot"></i>
                                        <%= advisor.location %>
                                    </span>
                                </div>

                                <div class="advisor-bottom">
                                    <span class="advisor-rating">
                                        <i class="fa-solid fa-star"></i>
                                        <%= advisor.rating %>
                                    </span>
                                    <strong>₹<%= advisor.consultationFee %> / सल्ला</strong>
                                </div>

                                <a href="/advisors/<%= advisor._id %>" class="btn btn-outline-success w-100 mt-3">प्रोफाइल पहा</a>
                            </div>
                        </div>
                    </div>
                <% }) %>

            <% } else { %>
                <div class="col-12">
                    <div class="text-center py-5">
                        <i class="fa-solid fa-user-slash fa-2x mb-3"></i>
                        <h3>सध्या कोणतेही सल्लागार उपलब्ध नाहीत.</h3>
                        <p>कृपया नंतर पुन्हा प्रयत्न करा.</p>
                    </div>
                </div>
            <% } %>

        </div>
    </div>
</section>