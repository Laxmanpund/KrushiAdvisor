<% layout("/layouts/boilerplate") %>

<section class="advisor-profile-section">
    <div class="container">

        <div class="advisor-breadcrumb">
            <a href="/">मुख्यपृष्ठ</a>
            <i class="fa-solid fa-chevron-right"></i>
            <a href="/advisors">कृषी सल्लागार</a>
            <i class="fa-solid fa-chevron-right"></i>
            <span><%= advisor.name %></span>
        </div>

        <div class="advisor-profile-header">
            <div class="advisor-profile-photo">
                <i class="fa-solid fa-user"></i>
            </div>

            <div class="advisor-profile-main">
                <% if (advisor.isAvailable) { %>
                    <span class="profile-status">
                        <i class="fa-solid fa-circle"></i>
                        सल्ल्यासाठी उपलब्ध
                    </span>
                <% } else { %>
                    <span class="profile-status">
                        <i class="fa-solid fa-circle"></i>
                        सध्या अनुपलब्ध
                    </span>
                <% } %>

                <h1><%= advisor.name %></h1>
                <p class="profile-qualification"><%= advisor.qualification %></p>


                <div class="profile-meta">
                    <span>
                        <i class="fa-solid fa-briefcase"></i>
                        <%= advisor.experience %> वर्षांचा अनुभव
                    </span>

                    <span>
                        <i class="fa-solid fa-location-dot"></i>
                        <%= advisor.location %>
                    </span>
                </div>
            </div>

            <div class="profile-book">
                <div class="profile-rating">
                    <i class="fa-solid fa-star"></i>
                    <strong><%= advisor.rating %></strong>
                    <span>अभिप्राय</span>
                </div>

                <strong class="profile-fee">₹<%= advisor.consultationFee %></strong>
                <span class="fee-label">प्रति सल्ला</span>

                <% if (advisor.isAvailable) { %>
                    <a href="/advisors/<%= advisor._id %>/book" class="btn btn-success">
                        सल्ला बुक करा
                        <i class="fa-solid fa-calendar-check"></i>
                    </a>
                <% } else { %>
                    <button class="btn btn-secondary" disabled>सध्या उपलब्ध नाही</button>
                <% } %>
            </div>
        </div>

        <div class="row g-4 mt-1">
            <div class="col-lg-8">

                <div class="profile-info-card">
                    <h2>
                        <i class="fa-solid fa-user"></i>
                        सल्लागाराबद्दल
                    </h2>
                    <p><%= advisor.about %></p>
                </div>

                <div class="profile-info-card">
                    <h2>
                        <i class="fa-solid fa-lightbulb"></i>
                        कौशल्याची क्षेत्रे
                    </h2>

                    <div class="profile-tags">
                        <% advisor.expertise.forEach(skill => { %>
                            <span><%= skill %></span>
                        <% }) %>
                    </div>
                </div>


                <div class="profile-info-card">
                    <h2>
                        <i class="fa-solid fa-briefcase"></i>
                        अनुभव
                    </h2>

                    <div class="experience-item">
                        <strong>कृषी सल्लागार</strong>
                        <span><%= advisor.experience %> वर्षांचा अनुभव</span>
                        <p><%= advisor.experienceDescription %></p>
                    </div>
                </div>

                <div class="profile-info-card">
                    <div class="review-heading">
                        <h2>
                            <i class="fa-solid fa-star"></i>
                            अभिप्राय
                        </h2>
                        <span><%= advisor.rating %> / 5</span>
                    </div>

                    <div class="review">
                        <div class="review-user">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div>
                            <strong>शेतकरी</strong>

                            <div class="review-stars">
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                            </div>

                            <p>
                                सल्लागाराची माहिती आणि मार्गदर्शन
                                उपयुक्त असल्याचे अभिप्राय.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="profile-side-card">
                    <h3>
                        <i class="fa-solid fa-calendar-days"></i>
                        उपलब्धता
                    </h3>

                    <div class="availability-item">
                        <span>सोमवार – शुक्रवार</span>
                        <strong>सकाळी 10:00 – संध्याकाळी 6:00</strong>
                    </div>

                    <div class="availability-item">
                        <span>शनिवार</span>
                        <strong>सकाळी 10:00 – दुपारी 2:00</strong>
                    </div>

                    <div class="availability-item">
                        <span>रविवार</span>
                        <strong>उपलब्ध नाही</strong>
                    </div>
                </div>

                <div class="profile-side-card consultation-card">
                    <h3>कृषी मार्गदर्शन हवे आहे?</h3>
                    <p>
                        तुमच्या शेतीशी संबंधित प्रश्नांवर
                        चर्चा करण्यासाठी या सल्लागारासोबत
                        सल्लामसलत बुक करा.
                    </p>

                    <% if (advisor.isAvailable) { %>
                        <a href="/advisors/<%= advisor._id %>/book" class="btn btn-success w-100">सल्ला बुक करा</a>
                    <% } else { %>
                        <button class="btn btn-secondary w-100" disabled>सध्या उपलब्ध नाही</button>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>