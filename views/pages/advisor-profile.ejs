<% layout("/layouts/boilerplate") %>

<section class="advisor-profile-section">
    <div class="container">

        <div class="advisor-breadcrumb">
            <a href="/">Home</a>
            <i class="fa-solid fa-chevron-right"></i>
            <a href="/advisors">Find Advisor</a>
            <i class="fa-solid fa-chevron-right"></i>
            <span>Advisor Profile</span>
        </div>

        <div class="advisor-profile-header">
            <div class="advisor-profile-photo">
                <i class="fa-solid fa-user"></i>
            </div>

            <div class="advisor-profile-main">
                <span class="profile-status">
                    <i class="fa-solid fa-circle"></i>
                    Available for Consultation
                </span>

                <h1>Dr. Rajesh Patil</h1>
                <p class="profile-qualification">M.Sc. Agriculture</p>

                <div class="profile-meta">
                    <span><i class="fa-solid fa-briefcase"></i>8 Years Experience</span>
                    <span><i class="fa-solid fa-location-dot"></i>Maharashtra</span>
                </div>
            </div>

            <div class="profile-book">
                <div class="profile-rating">
                    <i class="fa-solid fa-star"></i>
                    <strong>4.8</strong>
                    <span>24 Reviews</span>
                </div>

                <strong class="profile-fee">₹500</strong>
                <span class="fee-label">per consultation</span>
                <a href="/advisors/rajesh-patil/book" class="btn btn-success">Book Consultation<i class="fa-solid fa-calendar-check"></i></a>
            </div>
        </div>

        <!-- Main Profile Content -->

        <div class="row g-4 mt-1">
            <div class="col-lg-8">

                <div class="profile-info-card">
                    <h2><i class="fa-solid fa-user"></i>About the Advisor</h2>
                    <p>
                        Dr. Rajesh Patil is an agriculture professional
                        with experience in crop management and soil
                        science. He provides agricultural guidance
                        based on crop conditions and farming practices.
                    </p>
                </div>

                <div class="profile-info-card">
                    <h2><i class="fa-solid fa-lightbulb"></i>Areas of Expertise</h2>

                    <div class="profile-tags">
                        <span>Crop Management</span>
                        <span>Soil Science</span>
                        <span>Irrigation</span>
                        <span>Nutrient Management</span>
                    </div>
                </div>

                <div class="profile-info-card">
                    <h2><i class="fa-solid fa-briefcase"></i>Experience</h2>

                    <div class="experience-item">
                        <strong>Agriculture Advisor</strong>
                        <span>2018 – Present</span>
                        <p>
                            Providing agricultural guidance and
                            crop management support to farmers.
                        </p>
                    </div>
                </div>

                <div class="profile-info-card">
                    <div class="review-heading">
                        <h2><i class="fa-solid fa-star"></i>Reviews</h2>
                        <span>4.8 / 5</span>
                    </div>


                    <div class="review">
                        <div class="review-user">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div>
                            <strong>Farmer</strong>

                            <div class="review-stars">
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                            </div>

                            <p>
                                Helpful guidance and clear
                                explanation about crop management.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">

                <div class="profile-side-card">
                    <h3><i class="fa-solid fa-calendar-days"></i>Availability</h3>

                    <div class="availability-item">
                        <span>Monday – Friday</span>
                        <strong>10:00 AM – 6:00 PM</strong>
                    </div>

                    <div class="availability-item">
                        <span>Saturday</span>
                        <strong>10:00 AM – 2:00 PM</strong>
                    </div>

                    <div class="availability-item">
                        <span>Sunday</span>
                        <strong>Not Available</strong>
                    </div>
                </div>

                <div class="profile-side-card consultation-card">

                    <h3>Need Agricultural Guidance?</h3>
                    <p>
                        Book a consultation with this advisor
                        to discuss your farming-related questions.
                    </p>
                    <a href="/advisors/rajesh-patil/book" class="btn btn-success w-100">Book Consultation</a>
                </div>
            </div>
        </div>
    </div>
</section>