<% layout("/layouts/boilerplate") %>

<section class="contact-hero">
    <div class="container">
        <div class="contact-hero-content text-center">
            <span class="contact-badge">
                <i class="fa-solid fa-headset"></i>
                Krushi Advisor शी संपर्क
            </span>
            <h1>आम्ही तुमच्या मदतीसाठी येथे आहोत</h1>
            <p>
                तुम्हाला काही प्रश्न, सूचना किंवा Krushi Advisor वापरताना
                काही मदत हवी आहे का? आम्हाला संदेश पाठवा.
            </p>
        </div>
    </div>
</section>

<section class="contact-section">
    <div class="container">

        <div class="row g-5">

            <div class="col-lg-5">
                <span class="section-label">आमच्याशी संपर्क साधा</span>
                <h2>चला, संपर्कात राहूया</h2>
                <p class="contact-intro">
                    पिके, कृषी सल्लागार, Krushi Advisor प्लॅटफॉर्म
                    किंवा भविष्यातील सुविधांबाबत काही प्रश्न असल्यास
                    खालील माध्यमातून आमच्याशी संपर्क साधू शकता.
                </p>

                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>

                    <div>
                        <h3>ई-मेल</h3>
                        <p>support@krushiadvisor.com</p>
                    </div>
                </div>

                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <i class="fa-solid fa-phone"></i>
                    </div>

                    <div>
                        <h3>फोन</h3>
                        <p>+91 98765 43210</p>
                    </div>
                </div>

                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div>
                        <h3>ठिकाण</h3>
                        <p>महाराष्ट्र, भारत</p>
                    </div>
                </div>

                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <i class="fa-solid fa-clock"></i>
                    </div>

                    <div>
                        <h3>सपोर्टची वेळ</h3>
                        <p>सोमवार - शनिवार, सकाळी 10:00 ते संध्याकाळी 6:00</p>
                    </div>
                </div>
            </div>


            <div class="col-lg-7">
                <div class="contact-form-card">

                    <div class="mb-4">
                        <span class="section-label">संदेश पाठवा</span>
                        <h2>आम्ही तुमची कशी मदत करू शकतो?</h2>
                    </div>

                    <form>
                        <div class="mb-3">
                            <label for="name" class="form-label">पूर्ण नाव </label>
                            <input type="text" id="name" class="form-control" placeholder="तुमचे नाव टाका">
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">ई-मेल पत्ता</label>
                            <input type="email" id="email" class="form-control" placeholder="तुमचा ई-मेल पत्ता टाका">
                        </div>

                        <div class="mb-3">
                            <label for="subject" class="form-label">विषय</label>
                            <input type="text" id="subject" class="form-control" placeholder="तुमच्या संदेशाचा विषय लिहा">
                        </div>

                        <div class="mb-4">
                            <label for="message" class="form-label">संदेश</label>
                            <textarea id="message" class="form-control" rows="6" placeholder="तुमचा संदेश येथे लिहा..."></textarea>
                        </div>

                        <button type="submit"class="btn btn-success contact-submit">
                            <i class="fa-solid fa-paper-plane"></i>
                            संदेश पाठवा
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="contact-faq">
    <div class="container">

        <div class="text-center mb-5">
            <span class="section-label">सामान्य प्रश्न</span>
            <h2>वारंवार विचारले जाणारे प्रश्न</h2>
        </div>

        <div class="row g-4">

            <!-- FAQ 1 -->
            <div class="col-md-6">
                <div class="faq-card">
                    <i class="fa-solid fa-user-tie"></i>
                    <h3>कृषी सल्लागार कसा शोधायचा?</h3>
                    <p>
                        "कृषी सल्लागार" या पेजवर जा आणि
                        सल्लागारांचे कौशल्य व अनुभव यानुसार
                        योग्य सल्लागार शोधा.
                    </p>
                </div>
            </div>

            <!-- FAQ 2 -->
            <div class="col-md-6">
                <div class="faq-card">
                    <i class="fa-solid fa-calendar-check"></i>
                    <h3>मी कृषी सल्ला बुक करू शकतो का?</h3>
                    <p>
                        ऑनलाइन सल्ला बुकिंग ही Krushi Advisor च्या
                        भविष्यातील सुविधांपैकी एक आहे.
                    </p>
                </div>
            </div>

            <!-- FAQ 3 -->
            <div class="col-md-6">
                <div class="faq-card">
                    <i class="fa-solid fa-seedling"></i>
                    <h3>पिकांची माहिती कुठे मिळेल?</h3>
                    <p>
                        "पिके" या विभागात जाऊन विविध पिकांची
                        लागवड, माती, सिंचन, पेरणी आणि इतर
                        संबंधित माहिती पाहू शकता.
                    </p>
                </div>
            </div>


            <!-- FAQ 4 -->
            <div class="col-md-6">
                <div class="faq-card">
                    <i class="fa-solid fa-bug"></i>
                    <h3>पिकांवरील रोग व किडींबद्दल माहिती कुठे मिळेल?</h3>
                    <p>
                        "रोग व किडी" या विभागात विविध पिकांवरील
                        सामान्य रोग व किडी, त्यांची लक्षणे आणि
                        सामान्य व्यवस्थापनाबद्दल माहिती मिळेल.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="contact-cta">
    <div class="container">
        <div class="contact-cta-box text-center">
            <i class="fa-solid fa-comments"></i>
            <h2>कृषी मार्गदर्शनाची गरज आहे?</h2>
            <p>
                पिकांची माहिती जाणून घ्या किंवा तुमच्या
                शेतीच्या गरजेनुसार कृषी सल्लागार शोधा.
            </p>

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="/crops" class="btn btn-success">
                    <i class="fa-solid fa-seedling"></i>
                    पिकांची माहिती
                </a>
                <a href="/advisors" class="btn btn-outline-success">
                    <i class="fa-solid fa-user-tie"></i>
                    कृषी सल्लागार शोधा
                </a>
            </div>
        </div>
    </div>
</section>