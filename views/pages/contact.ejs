<% layout("/layouts/boilerplate") %>

<section class="contact-hero">
    <div class="container">
        <div class="contact-hero-content text-center">

            <span class="contact-badge">
                <i class="fa-solid fa-headset"></i>
                Contact Krushi Advisor
            </span>
            <h1>We're Here to Help</h1>
            <p>
                Have a question, suggestion or need help using Krushi Advisor?
                Send us a message and we'll be happy to hear from you.
            </p>

        </div>
    </div>
</section>


<!-- Contact Section -->
<section class="contact-section">
    <div class="container">
        <div class="row g-5">

            <!-- Contact Information -->
            <div class="col-lg-5">
                <span class="section-label">GET IN TOUCH</span>
                <h2>Let's Connect</h2>
                <p class="contact-intro">
                    Whether you have a question about crops, advisors,
                    the platform or future features, you can reach us
                    using the information below.
                </p>


                <!-- Email -->
                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>

                    <div>
                        <h3>Email</h3>
                        <p>support@krushiadvisor.com</p>
                    </div>
                </div>


                <!-- Phone -->
                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <i class="fa-solid fa-phone"></i>
                    </div>

                    <div>
                        <h3>Phone</h3>
                        <p>+91 98765 43210</p>
                    </div>
                </div>


                <!-- Location -->
                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div>
                        <h3>Location</h3>
                        <p>Maharashtra, India</p>
                    </div>
                </div>


                <!-- Support -->
                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <i class="fa-solid fa-clock"></i>
                    </div>

                    <div>
                        <h3>Support Hours</h3>
                        <p>Monday - Saturday, 10:00 AM - 6:00 PM</p>
                    </div>
                </div>
            </div>


            <!-- Contact Form -->
            <div class="col-lg-7">
                <div class="contact-form-card">
                    <div class="mb-4">
                        <span class="section-label">SEND A MESSAGE</span>
                        <h2>How Can We Help?</h2>
                    </div>


                    <form>
                        <!-- Name -->
                        <div class="mb-3">
                            <label for="name" class="form-label">Full Name</label>
                            <input type="text" id="name" class="form-control" placeholder="Enter your name">
                        </div>


                        <!-- Email -->
                        <div class="mb-3">
                            <label for="email" class="form-label">Email Address </label>
                            <input type="email" id="email" class="form-control" placeholder="Enter your email">
                        </div>


                        <!-- Subject -->
                        <div class="mb-3">
                            <label for="subject" class="form-label">Subject</label>
                            <input type="text" id="subject" class="form-control" placeholder="What is your message about?">
                        </div>


                        <!-- Message -->
                        <div class="mb-4">
                            <label for="message" class="form-label">Message</label>
                            <textarea id="message" class="form-control" rows="6" placeholder="Write your message here..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-success contact-submit">
                        <i class="fa-solid fa-paper-plane"></i>Send Message</button>
                    </form>
                </div>

            </div>
        </div>

    </div>
</section>


<!-- FAQ -->
<section class="contact-faq">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-label">FAQ</span>
            <h2>Frequently Asked Questions</h2>
        </div>


        <div class="row g-4">

            <!-- FAQ 1 -->
            <div class="col-md-6">
                <div class="faq-card">
                    <i class="fa-solid fa-user-tie"></i>
                    <h3>How can I find an agriculture advisor?</h3>
                    <p>
                        Visit the Find Advisor page and explore advisors
                        based on their expertise and experience.
                    </p>
                </div>
            </div>


            <!-- FAQ 2 -->
            <div class="col-md-6">
                <div class="faq-card">
                    <i class="fa-solid fa-calendar-check"></i>
                    <h3>Can I book a consultation?</h3>
                    <p>
                        Online consultation booking is planned as a
                        future feature of Krushi Advisor.
                    </p>
                </div>
            </div>


            <!-- FAQ 3 -->
            <div class="col-md-6">
                <div class="faq-card">
                    <i class="fa-solid fa-seedling"></i>
                    <h3>Where can I find crop information?</h3>
                    <p>
                        Visit the Crops section to explore information
                        about different crops.
                    </p>
                </div>
            </div>


            <!-- FAQ 4 -->
            <div class="col-md-6">
                <div class="faq-card">
                    <i class="fa-solid fa-bug"></i>
                    <h3>Where can I learn about crop diseases?</h3>
                    <p>
                        Visit the Disease & Pest section to explore
                        common agricultural diseases and pests.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="contact-cta">
    <div class="container">

        <div class="contact-cta-box text-center">
            <i class="fa-solid fa-comments"></i>
            <h2>Need Agricultural Guidance?</h2>
            <p>
                Explore crops or find an agriculture advisor
                for your farming needs.
            </p>

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="/crops" class="btn btn-success">
                    <i class="fa-solid fa-seedling"></i>
                    Explore Crops
                </a>

                <a href="/advisors" class="btn btn-outline-success">
                    <i class="fa-solid fa-user-tie"></i>
                    Find an Advisor
                </a>
            </div>

        </div>
    </div>
</section>