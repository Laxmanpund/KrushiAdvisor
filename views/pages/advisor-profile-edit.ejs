<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">प्रोफाइल संपादित करा</h1>
        <p class="text-muted">
            तुमची कृषी सल्लागार प्रोफाइल माहिती अपडेट करा.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form action="/advisor/profile/edit" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-semibold">नाव</label>
                    <input
                        type="text"
                        name="name"
                        class="form-control"
                        value="<%= advisor.name %>"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">शैक्षणिक पात्रता</label>
                    <input
                        type="text"
                        name="qualification"
                        class="form-control"
                        value="<%= advisor.qualification %>"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">तज्ज्ञता</label>
                    <input
                        type="text"
                        name="expertise"
                        class="form-control"
                        value="<%= advisor.expertise.join(', ') %>"
                        placeholder="उदा. Cotton, Soybean, Pest Management"
                    >

                    <div class="form-text">
                        वेगवेगळ्या तज्ज्ञता comma (,) ने वेगळ्या करा.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">अनुभव (वर्षे)</label>
                    <input
                        type="number"
                        name="experience"
                        class="form-control"
                        value="<%= advisor.experience %>"
                        min="0"
                        required>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">ठिकाण</label>
                    <input type="text" name="location" class="form-control" value="<%= advisor.location %>" required>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Consultation Fee (₹)</label>
                    <input type="number" name="consultationFee" class="form-control" value="<%= advisor.consultationFee %>" min="0" required>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">माझ्याबद्दल</label>
                    <textarea
                        name="about"
                        class="form-control"
                        rows="4"
                        placeholder="तुमच्याबद्दल थोडक्यात माहिती..."
                    ><%= advisor.about %></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">अनुभवाचे वर्णन</label>
                    <textarea
                        name="experienceDescription"
                        class="form-control"
                        rows="4"
                        placeholder="तुमच्या कृषी क्षेत्रातील अनुभवाबद्दल माहिती..."
                    ><%= advisor.experienceDescription %></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-floppy-disk"></i>
                        बदल जतन करा
                    </button>
                    <a href="/advisor/dashboard" class="btn btn-outline-secondary">रद्द करा</a>
                </div>
            </form>

        </div>
    </div>

</div>