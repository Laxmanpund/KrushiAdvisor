<% layout("/layouts/boilerplate") %>

<section class="disease-details-section">
    <div class="container">
        <div class="disease-breadcrumb">
            <a href="/">मुख्यपृष्ठ</a>
            <i class="fa-solid fa-chevron-right"></i>
            <a href="/diseases">रोग व किडी</a>
            <i class="fa-solid fa-chevron-right"></i>
            <span><%= disease.name %></span>
        </div>

        <div class="disease-details-header">
            <div class="disease-details-icon">
                <% if (disease.type === "कीड") { %>
                    <i class="fa-solid fa-bug"></i>
                <% } else { %>
                    <i class="fa-solid fa-virus"></i>
                <% } %>
            </div>

            <div>
                <span class="disease-type"><%= disease.type %></span>
                <h1><%= disease.name %></h1>
                <p><%= disease.description %></p>
            </div>
        </div>

        <div class="disease-info-section">
            <h2>
                <i class="fa-solid fa-seedling"></i>
                प्रभावित पीक
            </h2>

            <div class="affected-crop-box">
                <strong><%= disease.crop %></strong>
                <span><%= disease.type %></span>
            </div>
        </div>

        <div class="disease-info-section">
            <h2>
                <i class="fa-solid fa-circle-info"></i>
                रोग / किडीची माहिती
            </h2>
            <p><%= disease.description %></p>
        </div>

        <div class="disease-info-section">
            <h2>
                <i class="fa-solid fa-eye"></i>
                लक्षणे
            </h2>

            <% if (disease.symptoms && disease.symptoms.length > 0) { %>
                <ul class="disease-points">
                    <% disease.symptoms.forEach(symptom => { %>
                        <li><%= symptom %></li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p>या रोगाची किंवा किडीची लक्षणे सध्या उपलब्ध नाहीत.</p>
            <% } %>
        </div>

        <div class="disease-info-section">
            <h2>
                <i class="fa-solid fa-cloud-sun"></i>
                अनुकूल परिस्थिती
            </h2>

            <% if (disease.favorableConditions && disease.favorableConditions.length > 0) { %>
                <ul class="disease-points">
                    <% disease.favorableConditions.forEach(condition => { %>
                        <li><%= condition %></li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p>अनुकूल परिस्थितीची माहिती सध्या उपलब्ध नाही.</p>
            <% } %>
        </div>

        <div class="disease-info-section">
            <h2>
                <i class="fa-solid fa-shield-halved"></i>
                सामान्य व्यवस्थापन
            </h2>

            <% if (disease.management && disease.management.length > 0) { %>
                <ul class="disease-points">
                    <% disease.management.forEach(item => { %>
                        <li><%= item %></li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p>व्यवस्थापनाची माहिती सध्या उपलब्ध नाही.</p>
            <% } %>
        </div>

        <div class="disease-info-section">
            <h2>
                <i class="fa-solid fa-check-circle"></i>
                प्रतिबंध
            </h2>

            <% if (disease.prevention && disease.prevention.length > 0) { %>
                <ul class="disease-points">
                    <% disease.prevention.forEach(item => { %>
                        <li><%= item %></li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p>प्रतिबंधात्मक माहिती सध्या उपलब्ध नाही.</p>
            <% } %>
        </div>

        <div class="disease-advisor-cta">
            <div>
                <h2>
                    पिकाच्या समस्येची ओळख पटवण्यासाठी
                    मदत हवी आहे का?
                </h2>
                <p>
                    वैयक्तिक मार्गदर्शनासाठी
                    कृषी सल्लागाराशी संपर्क साधा.
                </p>
            </div>

            <a href="/advisors" class="btn btn-success">
                कृषी सल्लागार शोधा
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    </div>
</section>