<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <div class="mb-5">
        <h1 class="fw-bold">नमस्कार, <%= advisor.name %> 👋</h1>
        <p class="text-muted">तुमचे कृषी मार्गदर्शन आणि सल्ला येथे व्यवस्थापित करा.</p>
    </div>

    <div class="row g-4 mb-5">

        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h3 class="fw-bold mb-3">
                        <i class="fa-solid fa-user-doctor"></i>
                        माझी प्रोफाइल
                    </h3>

                    <p>
                        <strong>शैक्षणिक पात्रता:</strong>
                        <%= advisor.qualification %>
                    </p>

                    <p>
                        <strong>अनुभव:</strong>
                        <%= advisor.experience %> वर्षे
                    </p>

                    <p>
                        <strong>ठिकाण:</strong>
                        <%= advisor.location %>
                    </p>

                    <p>
                        <strong>Consultation Fee:</strong>
                        ₹<%= advisor.consultationFee %>
                    </p>

                    <p>
                        <strong>Rating:</strong>
                        <i class="fa-solid fa-star text-warning"></i>
                        <%= advisor.rating %> / 5
                    </p>
                    <a href="/advisors/<%= advisor._id %>" class="btn btn-outline-success">प्रोफाइल पहा</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">

                   <% if (advisor.isAvailable) { %>
                      <i class="fa-solid fa-circle-check fs-1 text-success"></i>
                      <h4 class="mt-3">उपलब्धता</h4>
                      <span class="badge text-bg-success fs-6">सध्या उपलब्ध</span>
                      <p class="text-muted mt-3">शेतकरी तुमच्याशी सल्लामसलतीसाठी संपर्क करू शकतात.</p>

                       <form action="/advisor/availability" method="POST" class="mt-3">
                           <button type="submit" class="btn btn-outline-danger">
                               <i class="fa-solid fa-toggle-off"></i>
                               अनुपलब्ध करा
                            </button>
                        </form>

                    <% } else { %>
                        <i class="fa-solid fa-circle-xmark fs-1 text-secondary"></i>
                        <h4 class="mt-3">उपलब्धता</h4>
                        <span class="badge text-bg-secondary fs-6">सध्या अनुपलब्ध</span>
                        <p class="text-muted mt-3">सध्या शेतकरी तुमच्याशी consultation करू शकत नाहीत.</p>

                        <form action="/advisor/availability" method="POST" class="mt-3">
                            <button type="submit" class="btn btn-success">
                                <i class="fa-solid fa-toggle-on"></i>
                                उपलब्ध करा
                            </button>
                       </form>
                   <% } %>
                </div>
            </div>
        </div>
    </div>


    <div class="card shadow-sm mb-5">
        <div class="card-body">

            <h3 class="fw-bold mb-4">
                <i class="fa-solid fa-seedling"></i>
                माझे तज्ज्ञ क्षेत्र
            </h3>

            <div class="d-flex flex-wrap gap-2">
                <% advisor.expertise.forEach(skill => { %>
                    <span class="badge text-bg-light border p-2">
                        <%= skill %>
                    </span>
                <% }) %>

            </div>

        </div>
    </div>


    <div class="card shadow-sm">

        <div class="card-body">
            <h3 class="fw-bold">
                <i class="fa-solid fa-calendar-check"></i>
                Consultation Requests
            </h3>
            <p class="text-muted">शेतकऱ्यांकडून आलेल्या consultation requests येथे दिसतील.</p>

            <div class="alert alert-info mb-0">
                सध्या कोणत्याही consultation requests नाहीत.
                <br>
                Booking system तयार केल्यानंतर येथे requests दिसतील.
            </div>

        </div>
    </div>
</div>