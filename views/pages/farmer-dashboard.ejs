<% layout("/layouts/boilerplate") %>


<div class="container py-5">

    <div class="mb-5">
        <h1 class="fw-bold">नमस्कार, <%= currentUser.name %> 👋</h1>
        <p class="text-muted">तुमच्या शेतीसाठी योग्य माहिती आणि कृषी मार्गदर्शन मिळवा.</p>
    </div>


    <div class="row g-4 mb-5">

        <!-- Crops -->
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">

                <div class="card-body">
                    <i class="fa-solid fa-wheat-awn fs-2 text-success"></i>
                    <h5 class="mt-3">पिकांची माहिती</h5>

                    <p class="text-muted">
                        विविध पिकांची लागवड, माती,
                        सिंचन आणि खत व्यवस्थापनाची माहिती.
                    </p>

                    <a href="/crops" class="btn btn-outline-success">माहिती पहा</a>
                </div>
                
            </div>
        </div>

        <!-- Diseases -->
        <div class="col-md-3">

            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="fa-solid fa-bug fs-2 text-danger"></i>
                    <h5 class="mt-3">रोग व किडी</h5>

                    <p class="text-muted">
                        पिकांवरील सामान्य रोग आणि किडींची
                        लक्षणे व व्यवस्थापन जाणून घ्या.
                    </p>

                    <a href="/diseases" class="btn btn-outline-danger">माहिती पहा</a>
                </div>
            </div>
        </div>

        <!-- Advisors -->
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="fa-solid fa-user-doctor fs-2 text-primary"></i>
                    <h5 class="mt-3">कृषी सल्लागार</h5>

                    <p class="text-muted">
                        अनुभवी कृषी सल्लागार शोधा
                        आणि योग्य मार्गदर्शन मिळवा.
                    </p>

                    <a href="/advisors" class="btn btn-outline-primary">सल्लागार पहा</a>
                </div>
            </div>
        </div>


        <!-- My Bookings -->
        <div class="col-md-3">

            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="fa-solid fa-calendar-check fs-2 text-warning"></i>
                    <h5 class="mt-3">माझ्या भेटी</h5>

                    <p class="text-muted">
                        तुमच्या कृषी सल्लामसलती
                        आणि बुकिंगची माहिती येथे पहा.
                    </p>

                    <a href="#myBookings" class="btn btn-outline-warning">भेटी पहा</a>
                </div>

            </div>
        </div>
    </div>

    <!-- My Bookings -->

    <div class="mb-5" id="myBookings">
        <div class="mb-4">
            <h2 class="fw-bold">
                <i class="fa-solid fa-calendar-check text-warning"></i>
                माझ्या सल्लामसलती
            </h2>

            <p class="text-muted">
                तुमच्या कृषी सल्लागारांसोबत केलेल्या
                बुकिंगची माहिती.
            </p>
        </div>

        <!-- No Bookings -->
        <% if (bookings.length === 0) { %>
            <div class="alert alert-info">
                <i class="fa-solid fa-circle-info"></i>
                अजून कोणतीही सल्लामसलत बुक केलेली नाही.
                <a href="/advisors" class="ms-2">सल्लागार शोधा</a>
            </div>

        <% } else { %>

            <!-- Booking Cards -->
            <div class="row g-4">
                <% bookings.forEach(booking => { %>
                    <div class="col-lg-6">
                        <div class="card shadow-sm h-100">

                            <div class="card-body p-4">
                                <!-- Advisor Header -->
                                <div class="d-flex justify-content-between align-items-start">

                                    <div>
                                        <h4 class="fw-bold mb-1"><%= booking.advisor.name %></h4>
                                        <p class="text-muted mb-0"><%= booking.advisor.qualification %></p>
                                    </div>


                                    <!-- Status -->
                                    <% if (booking.status === "pending") { %>
                                        <span class="badge bg-warning text-dark">
                                            <i class="fa-solid fa-clock"></i>
                                            Pending
                                        </span>

                                    <% } else if (booking.status === "accepted") { %>
                                        <span class="badge bg-success">
                                            <i class="fa-solid fa-check"></i>
                                            Accepted
                                        </span>

                                    <% } else if (booking.status === "rejected") { %>
                                       <span class="badge bg-danger">
                                            <i class="fa-solid fa-xmark"></i>
                                            Rejected
                                        </span>

                                    <% } else if (booking.status === "completed") { %>
                                        <span class="badge bg-primary">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Completed
                                        </span>
                                    <% } %>
                                </div>

                                <hr>

                                <!-- Date -->
                                <div class="mb-3">
                                    <strong>
                                        <i class="fa-solid fa-calendar text-success"></i>
                                        तारीख
                                    </strong>

                                    <p class="text-muted mb-0">
                                        <%= new Date(
                                            booking.date
                                        ).toLocaleDateString("mr-IN") %>
                                    </p>
                                </div>

                                <!-- Time -->
                                <div class="mb-3">
                                    <strong>
                                        <i class="fa-solid fa-clock text-success"></i>
                                        वेळ
                                    </strong>
                                    <p class="text-muted mb-0"><%= booking.time %></p>
                                </div>

                                <!-- Problem -->
                                <div class="mb-3">
                                    <strong>
                                        <i class="fa-solid fa-file-lines text-success"></i>
                                        तुमची समस्या
                                    </strong>
                                    <p class="text-muted mt-1 mb-0"><%= booking.problem %></p>
                                </div>


                                <!-- Fee -->
                                <div class="d-flex justify-content-between align-items-center">
                                    <span>
                                        <i class="fa-solid fa-indian-rupee-sign text-success"></i>
                                        Consultation Fee
                                    </span>
                                    <strong class="text-success fs-5">₹<%= booking.advisor.consultationFee %></strong>
                                </div>

                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <!-- Available Advisors -->

    <div class="mb-4">
        <h2 class="fw-bold">उपलब्ध कृषी सल्लागार</h2>
        <p class="text-muted">
            सध्या उपलब्ध असलेल्या सल्लागारांकडून
            मार्गदर्शन मिळवा.
        </p>
    </div>


    <div class="row g-4">
        <% if (advisors.length === 0) { %>
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="fa-solid fa-circle-info"></i>
                    सध्या कोणताही सल्लागार उपलब्ध नाही.
                </div>
            </div>
        <% } %>

        <% advisors.forEach(advisor => { %>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">

                    <div class="card-body">
                        <h5 class="fw-bold"><%= advisor.name %></h5>
                        <p class="text-muted mb-2"><%= advisor.qualification %></p>

                        <p>
                            <i class="fa-solid fa-location-dot"></i>
                            <%= advisor.location %>
                        </p>

                        <p>
                            <i class="fa-solid fa-star text-warning"></i>
                            <%= advisor.rating %> / 5
                        </p>

                        <p>
                            <i class="fa-solid fa-indian-rupee-sign"></i>
                            ₹<%= advisor.consultationFee %> / consultation
                        </p>

                        <a href="/advisors/<%= advisor._id %>" class="btn btn-success w-100">
                            प्रोफाइल पहा
                        </a>
                    </div>

                </div>
            </div>

        <% }) %>
    </div>

</div>