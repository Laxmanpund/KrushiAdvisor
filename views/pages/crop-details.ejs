<% layout("/layouts/boilerplate") %>

<section class="crop-details-section">

    <div class="container">
        <div class="crop-breadcrumb">
            <a href="/">Home</a>
            <i class="fa-solid fa-chevron-right"></i>
            <a href="/crops">Crops</a>
            <i class="fa-solid fa-chevron-right"></i>
            <span>Wheat</span>
        </div>

        <div class="crop-details-header">

            <div class="crop-details-icon">
                <i class="fa-solid fa-wheat-awn"></i>
            </div>

            <div>
                <span class="crop-category">Rabi Crop</span>
                <h1>Wheat</h1>
                <p>
                    Wheat is an important cereal crop cultivated
                    mainly during the Rabi season.
                </p>
            </div>
        </div>

        <div class="crop-info-section">
            <h2>
                <i class="fa-solid fa-circle-info"></i>
                Overview
            </h2>
            <p>
                Wheat is one of the major cereal crops. It requires
                suitable soil, appropriate temperature, adequate
                irrigation and proper nutrient management for good growth.
            </p>

        </div>


        <!-- Soil & Climate -->

        <div class="row g-4">
            <div class="col-md-6">

                <div class="info-card">
                    <div class="info-icon">
                        <i class="fa-solid fa-mountain"></i>
                    </div>

                    <h3>Suitable Soil</h3>
                    <p>
                        Well-drained loamy and clay-loam soils
                        with suitable fertility are generally
                        suitable for wheat cultivation.
                    </p>

                </div>

            </div>


            <div class="col-md-6">
                <div class="info-card">

                    <div class="info-icon">
                        <i class="fa-solid fa-temperature-half"></i>
                    </div>

                    <h3>Climate</h3>
                    <p>
                        Wheat generally performs well under cool
                        conditions during the growing season.
                    </p>

                </div>

            </div>

        </div>


        <!-- Sowing -->

        <div class="crop-info-section">

            <h2>
                <i class="fa-solid fa-seedling"></i>
                Sowing Information
            </h2>

            <div class="info-grid">

                <div>
                    <span>Season</span>
                    <strong>Rabi</strong>
                </div>

                <div>
                    <span>Typical Sowing Period</span>
                    <strong>October – November</strong>
                </div>

                <div>
                    <span>Method</span>
                    <strong>Line / Drill Sowing</strong>
                </div>

            </div>

        </div>


        <!-- Irrigation -->

        <div class="crop-info-section">

            <h2>
                <i class="fa-solid fa-droplet"></i>
                Irrigation
            </h2>

            <p>
                Irrigation should be planned according to soil,
                weather conditions and crop growth stage. Critical
                growth stages should receive appropriate moisture.
            </p>

        </div>


        <!-- Fertilizer -->

        <div class="crop-info-section">

            <h2>
                <i class="fa-solid fa-flask"></i>
                Fertilizer & Nutrient Management
            </h2>

            <p>
                Nutrient management should be based on soil testing
                and recommended agricultural practices. Balanced
                application of nutrients helps maintain healthy crop growth.
            </p>

        </div>


        <!-- Diseases -->

        <div class="crop-info-section">

            <h2>
                <i class="fa-solid fa-bug"></i>
                Common Diseases & Pests
            </h2>

            <div class="disease-list">

                <a href="/diseases">
                    <i class="fa-solid fa-arrow-right"></i>
                    Rust
                </a>

                <a href="/diseases">
                    <i class="fa-solid fa-arrow-right"></i>
                    Powdery Mildew
                </a>

            </div>

        </div>

        <div class="crop-info-section">
            <h2><i class="fa-solid fa-wheat-awn"></i>Harvesting</h2>
            <p>
                Harvesting should be carried out when the crop reaches
                appropriate maturity and grain moisture conditions.
            </p>
        </div>

        <div class="advisor-cta">
            <div>
                <h2>Need help with your crop?</h2>
                <p>
                    Connect with an agriculture advisor for
                    personalized guidance.
                </p>
            </div>

            <a href="/advisors" class="btn btn-success">Find an Advisor<i class="fa-solid fa-arrow-right"></i></a>
        </div>

    </div>
</section>