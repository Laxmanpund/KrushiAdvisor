<% layout("/layouts/boilerplate") %>

<section class="crop-details-section">
    <div class="container">

        <div class="crop-breadcrumb">
            <a href="/">मुख्यपृष्ठ</a>
            <i class="fa-solid fa-chevron-right"></i>
            <a href="/crops">पिके</a>
            <i class="fa-solid fa-chevron-right"></i>
            <span><%= crop.name %></span>
        </div>

        <div class="crop-details-header">
            <div class="crop-details-icon">
                <% if (crop.name === "गहू") { %>
                    <i class="fa-solid fa-wheat-awn"></i>
                <% } else if (crop.name === "कापूस") { %>
                    <i class="fa-solid fa-seedling"></i>
                <% } else if (crop.name === "सोयाबीन") { %>
                    <i class="fa-solid fa-leaf"></i>
                <% } else if (crop.name === "भात") { %>
                    <i class="fa-solid fa-bowl-rice"></i>
                <% } else { %>
                    <i class="fa-solid fa-seedling"></i>
                <% } %>
            </div>

            <div>
                <span class="crop-category"><%= crop.category %></span>
                <h1><%= crop.name %></h1>
                <p>
                    <%= crop.name %>
                    हे एक महत्त्वाचे कृषी पीक असून
                    त्याची लागवड योग्य हंगाम,
                    माती, सिंचन आणि पीक व्यवस्थापनानुसार
                    केली जाते.
                </p>
            </div>
        </div>

        <div class="crop-info-section">
            <h2>
                <i class="fa-solid fa-circle-info"></i>
                पिकाची ओळख
            </h2>
            <p>
                <%= crop.name %>
                पिकाच्या चांगल्या वाढीसाठी योग्य माती,
                अनुकूल हवामान, आवश्यक सिंचन आणि
                संतुलित अन्नद्रव्य व्यवस्थापन महत्त्वाचे आहे.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="info-card">

                    <div class="info-icon">
                        <i class="fa-solid fa-mountain"></i>
                    </div>

                    <h3>योग्य माती</h3>
                    <p><%= crop.soil %></p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-card">

                    <div class="info-icon">
                        <i class="fa-solid fa-temperature-half"></i>
                    </div>

                    <h3>हवामान</h3>
                    <p>
                        <%= crop.name %>
                        पिकासाठी योग्य तापमान आणि
                        स्थानिक हवामानानुसार लागवड व
                        पीक व्यवस्थापन करणे आवश्यक आहे.
                    </p>
                </div>
            </div>
        </div>

        <div class="crop-info-section">
            <h2>
                <i class="fa-solid fa-seedling"></i>
                पेरणीची माहिती
            </h2>

            <div class="info-grid">
                <div>
                    <span>हंगाम</span>
                    <strong><%= crop.season %></strong>
                </div>

                <div>
                    <span>पेरणीचा कालावधी</span>
                    <strong><%= crop.sowing %></strong>
                </div>

                <div>
                    <span>पीक प्रकार</span>
                    <strong><%= crop.category %></strong>
                </div>
            </div>
        </div>

        <div class="crop-info-section">
            <h2>
                <i class="fa-solid fa-droplet"></i>
                सिंचन व्यवस्थापन
            </h2>
            <p><%= crop.irrigation %></p>
        </div>

        <div class="crop-info-section">
            <h2>
                <i class="fa-solid fa-flask"></i>
                खत व अन्नद्रव्य व्यवस्थापन
            </h2>
            <p><%= crop.fertilizer %></p>
        </div>

        <div class="crop-info-section">
            <h2>
                <i class="fa-solid fa-bug"></i>
                सामान्य रोग व किडी
            </h2>

            <% if (crop.commonDiseases && crop.commonDiseases.length > 0) { %>
                <div class="disease-list">

                    <% crop.commonDiseases.forEach(disease => { %>
                        <a href="/diseases">
                            <i class="fa-solid fa-arrow-right"></i>
                            <%= disease %>
                        </a>
                    <% }) %>
                </div>

            <% } else { %>
                <p>
                    या पिकासाठी सध्या रोग व किडींची
                    माहिती उपलब्ध नाही.
                </p>
            <% } %>
        </div>

        <div class="crop-info-section">
            <h2>
                <i class="fa-solid fa-wheat-awn"></i>
                काढणी
            </h2>
            <p><%= crop.harvesting %></p>
        </div>

        <div class="advisor-cta">
            <div>
                <h2>तुमच्या पिकासाठी मार्गदर्शन हवे आहे का?</h2>
                <p>
                    तुमच्या शेतीच्या गरजेनुसार
                    वैयक्तिक मार्गदर्शनासाठी
                    कृषी सल्लागार शोधा.
                </p>
            </div>

            <a href="/advisors" class="btn btn-success">
                कृषी सल्लागार शोधा
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

    </div>
</section>