<% layout("/layouts/boilerplate") %>

<section class="disease-section">

    <div class="container">

        <div class="section-heading text-center">

            <p class="section-subtitle">CROP HEALTH</p>

            <h1>Disease & Pest Guide</h1>

            <p class="section-description">
                Identify common crop diseases and pests and learn
                about their symptoms, causes and general management.
            </p>

        </div>

        <div class="disease-search">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search disease or pest...">
                <button class="btn btn-success">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Search
                </button>

            </div>
        </div>

        <div class="disease-filters text-center">

            <button class="btn btn-success">
                All
            </button>

            <button class="btn btn-outline-success">
                Diseases
            </button>

            <button class="btn btn-outline-success">
                Pests
            </button>

            <button class="btn btn-outline-success">
                Wheat
            </button>

            <button class="btn btn-outline-success">
                Cotton
            </button>

            <button class="btn btn-outline-success">
                Soybean
            </button>

        </div>


        <!-- Disease Cards -->

        <div class="row g-4 mt-4">
            <div class="col-md-6 col-lg-4">

                <div class="disease-card">

                    <div class="disease-icon">
                        <i class="fa-solid fa-virus"></i>
                    </div>

                    <div class="disease-content">

                        <span class="disease-type">Disease</span>
                        <h3>Wheat Rust</h3>
                        <p>
                            A fungal disease that can affect wheat
                            and reduce crop growth and productivity.
                        </p>

                        <div class="affected-crop">

                            <i class="fa-solid fa-seedling"></i>

                            Affected Crop:
                            <strong>Wheat</strong>

                        </div>

                        <a href="/diseases/wheat-rust">
                            View Details
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                    </div>
                </div>
            </div>


            <!-- Bollworm -->

            <div class="col-md-6 col-lg-4">

                <div class="disease-card">

                    <div class="disease-icon pest-icon">
                        <i class="fa-solid fa-bug"></i>
                    </div>

                    <div class="disease-content">

                        <span class="disease-type">Pest</span>
                        <h3>Cotton Bollworm</h3>
                        <p>
                            A common cotton pest that can damage
                            reproductive parts of the crop.
                        </p>

                        <div class="affected-crop">

                            <i class="fa-solid fa-seedling"></i>

                            Affected Crop:
                            <strong>Cotton</strong>

                        </div>

                        <a href="/diseases/cotton-bollworm">
                            View Details
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                    </div>
                </div>
            </div>


            <!-- Powdery Mildew -->

            <div class="col-md-6 col-lg-4">

                <div class="disease-card">

                    <div class="disease-icon">
                        <i class="fa-solid fa-virus"></i>
                    </div>

                    <div class="disease-content">
                        <span class="disease-type">Disease</span>
                        <h3>Powdery Mildew</h3>
                        <p>
                            A fungal disease that can appear as
                            powder-like growth on plant surfaces.
                        </p>

                        <div class="affected-crop">

                            <i class="fa-solid fa-seedling"></i>

                            Affected Crop:
                            <strong>Multiple Crops</strong>

                        </div>

                        <a href="/diseases/powdery-mildew">
                            View Details
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                    </div>
                </div>
            </div>


            <!-- Soybean Pest -->

            <div class="col-md-6 col-lg-4">

                <div class="disease-card">

                    <div class="disease-icon pest-icon">
                        <i class="fa-solid fa-bug"></i>
                    </div>

                    <div class="disease-content">
                        <span class="disease-type">Pest</span>
                        <h3>Soybean Pod Borer</h3>
                        <p>
                            A pest that may affect soybean pods
                            and impact seed development.
                        </p>

                        <div class="affected-crop">
                            <i class="fa-solid fa-seedling"></i>

                            Affected Crop:
                            <strong>Soybean</strong>

                        </div>

                        <a href="/diseases/soybean-pod-borer">
                            View Details
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>

                </div>

            </div>
        </div>


        <!-- Advisor CTA -->

        <div class="disease-cta">
            <div>
                <h2>Can't identify your crop problem?</h2>
                <p>
                    Connect with an agriculture advisor for
                    professional guidance.
                </p>

            </div>

            <a href="/advisors" class="btn btn-success">
                Find an Advisor
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

    </div>

</section>