<% layout("/layouts/boilerplate") %>

<section class="disease-section">
    <div class="container">

        <div class="section-heading text-center">
            <p class="section-subtitle">पीक आरोग्य</p>
            <h1>रोग व किडींचे मार्गदर्शन</h1>
            <p class="section-description">
                पिकांवरील सामान्य रोग व किडी ओळखा आणि
                त्यांची लक्षणे, कारणे व सामान्य व्यवस्थापनाबद्दल
                माहिती जाणून घ्या.
            </p>
        </div>

        <div class="disease-search">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="रोग किंवा कीड शोधा...">
                <button class="btn btn-success">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    शोधा
                </button>
            </div>
        </div>

        <div class="disease-filters text-center">
            <button class="btn btn-success">सर्व</button>
            <button class="btn btn-outline-success">रोग</button>
            <button class="btn btn-outline-success">किडी</button>
            <button class="btn btn-outline-success">गहू</button>
            <button class="btn btn-outline-success">कापूस</button>
            <button class="btn btn-outline-success">सोयाबीन</button>
        </div>

        <div class="row g-4 mt-4">
            <% diseases.forEach(disease => { %>
                <div class="col-md-6 col-lg-4">

                    <div class="disease-card">
                        <div class="disease-icon">
                            <% if (disease.type === "कीड") { %>
                                <i class="fa-solid fa-bug"></i>
                            <% } else { %>
                                <i class="fa-solid fa-virus"></i>
                            <% } %>
                        </div>

                        <div class="disease-content">
                            <span class="disease-type"><%= disease.type %></span>
                            <h3><%= disease.name %></h3>
                            <p><%= disease.description %></p>

                            <div class="affected-crop">
                                <i class="fa-solid fa-seedling"></i>
                                प्रभावित पीक:
                                <strong><%= disease.crop %></strong>
                            </div>

                            <a href="/diseases/<%= disease._id %>">
                                अधिक माहिती
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <div class="disease-cta">
            <div>
                <h2>तुमच्या पिकाची समस्या ओळखता येत नाही?</h2>
                <p>
                    योग्य मार्गदर्शनासाठी कृषी सल्लागाराशी
                    संपर्क साधा.
                </p>
            </div>

            <a href="/advisors" class="btn btn-success">
                कृषी सल्लागार शोधा
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

    </div>
</section>