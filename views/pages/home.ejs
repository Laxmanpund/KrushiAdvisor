<% layout("/layouts/boilerplate") %>

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <p class="hero-subtitle">
                    🌱 स्मार्ट शेती • योग्य निर्णय
                </p>

                <h1 class="hero-title">
                    शेती करा अधिक स्मार्ट
                    <span>Krushi Advisor सोबत</span>
                </h1>

                <p class="hero-text">
                    पिकांची माहिती, रोग व किडींबाबत मार्गदर्शन
                    आणि कृषी सल्लागारांशी संपर्क —
                    शेतीसाठी योग्य निर्णय घेण्यासाठी आवश्यक माहिती
                    एकाच ठिकाणी मिळवा.
                </p>

                <div class="hero-buttons">
                    <a href="/crops" class="btn btn-success btn-lg">
                        🌱
                        पिकांची माहिती
                    </a>

                    <a href="/advisors" class="btn btn-outline-success btn-lg">
                        <i class="fa-solid fa-user-tie"></i>
                        कृषी सल्लागार शोधा
                    </a>
                </div>
            </div>


            <div class="col-lg-6">
                <div class="hero-card">

                    <div class="hero-icon">🌾</div>
                    <h3>तुमचा डिजिटल कृषी सहाय्यक</h3>
                    <p>
                        पिकांची माहिती, रोग व किडींचे मार्गदर्शन
                        आणि कृषी तज्ज्ञांचा सल्ला —
                        सर्व काही एकाच ठिकाणी.
                    </p>

                    <div class="row text-center mt-4">
                        <div class="col-4">
                            <h4>
                                <i class="fa-solid fa-seedling"></i>
                            </h4>
                            <small>पिके</small>
                        </div>

                        <div class="col-4">
                            <h4><i class="fa-solid fa-bug"></i></h4>
                            <small>रोग व किडी</small>
                        </div>

                        <div class="col-4">
                            <h4><i class="fa-solid fa-user-tie"></i></h4>
                            <small>तज्ज्ञ</small>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>


<section class="popular-crops-section">
    <div class="container">

        <div class="section-heading text-center">
            <p class="section-subtitle">लोकप्रिय पिके</p>
            <h2>पिकांची माहिती जाणून घ्या</h2>

            <p class="section-description">
                विविध पिकांसाठी माती, सिंचन, पेरणी,
                खत व्यवस्थापन आणि काढणी याबद्दल माहिती मिळवा.
            </p>
        </div>

        <div class="row g-4 mt-4">

            <!-- Wheat -->

            <div class="col-md-6 col-lg-3">
                <div class="crop-card">

                    <div class="crop-image">
                        <i class="fa-solid fa-wheat-awn"></i>
                    </div>

                    <div class="crop-content">
                        <span class="crop-category">रब्बी पीक</span>
                        <h3>गहू</h3>
                        <p>
                            गव्हासाठी माती, सिंचन,
                            पेरणी आणि काढणीची माहिती.
                        </p>

                        <a href="/crops/wheat">
                            अधिक माहिती
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="crop-card">

                    <div class="crop-image">
                        <i class="fa-solid fa-seedling"></i>
                    </div>

                    <div class="crop-content">
                        <span class="crop-category">खरीप पीक</span>
                        <h3>कापूस</h3>
                        <p>
                            कापूस लागवड, सिंचन आणि
                            पीक व्यवस्थापनाबद्दल माहिती.
                        </p>

                        <a href="/crops/cotton">
                            अधिक माहिती
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="crop-card">

                    <div class="crop-image">
                        <i class="fa-solid fa-leaf"></i>
                    </div>

                    <div class="crop-content">
                        <span class="crop-category">खरीप पीक</span>
                        <h3>सोयाबीन</h3>
                        <p>
                            मातीची तयारी, पेरणी आणि
                            सिंचन व्यवस्थापनाबद्दल माहिती.
                        </p>

                        <a href="/crops/soybean">
                            अधिक माहिती
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="crop-card">

                    <div class="crop-image">
                        <i class="fa-solid fa-bowl-rice"></i>
                    </div>

                    <div class="crop-content">
                        <span class="crop-category">खरीप पीक</span>
                        <h3>भात</h3>
                        <p>
                            भात लागवड, पाणी व्यवस्थापन
                            आणि काढणीबद्दल माहिती.
                        </p>

                        <a href="/crops/rice">
                            अधिक माहिती
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a href="/crops" class="btn btn-success">
                सर्व पिके पहा
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    </div>
</section>