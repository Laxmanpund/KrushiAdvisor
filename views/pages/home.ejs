<% layout("/layouts/boilerplate") %>

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <p class="hero-subtitle">
                    🌱 Smart Farming • Better Decisions
                </p>

                <h1 class="hero-title">
                    Grow Better with
                    <span>Krushi Advisor</span>
                </h1>

                <p class="hero-text">
                    Get reliable agricultural guidance, crop information,
                    disease solutions and connect with agriculture advisors
                    for better farming decisions.
                </p>

                <div class="hero-buttons">
                    <a href="/crops" class="btn btn-success btn-lg">Explore Crops</a>
                    <a href="/advisors" class="btn btn-outline-success btn-lg">Find an Advisor</a>
                </div>
            </div>

            <div class="col-lg-6">

                <div class="hero-card">
                    <div class="hero-icon">🌾</div>
                    <h3>Your Farming Assistant</h3>
                    <p>Crop guidance, disease information and expert agricultural advice — all in one place.</p>

                   <div class="row text-center mt-4">
                        <div class="col-4">
                           <h4><i class="fa-solid fa-seedling"></i></h4>
                           <small>Crops</small>
                        </div>

                        <div class="col-4">
                           <h4><i class="fa-solid fa-bug"></i></h4>
                           <small>Diseases</small>
                        </div>

                        <div class="col-4">
                            <h4><i class="fa-solid fa-user-tie"></i></h4>
                            <small>Experts</small>
                       </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

<!-- Popular Crops Section -->

<section class="popular-crops-section">
    <div class="container">

        <div class="section-heading text-center">
            <p class="section-subtitle">POPULAR CROPS</p>
            <h2>Explore Crop Information</h2>
            
            <p class="section-description">
                Learn about soil, irrigation, sowing, fertilizer
                and harvesting requirements for different crops.
            </p>

        </div>


        <!-- Crop Cards -->

        <div class="row g-4 mt-4">

            <!-- Wheat -->

            <div class="col-md-6 col-lg-3">
                <div class="crop-card">
                    <div class="crop-image"><i class="fa-solid fa-wheat-awn"></i></div>

                    <div class="crop-content">
                        <span class="crop-category">Rabi Crop</span>
                        <h3>Wheat</h3>
                        <p>Information about soil, irrigation, sowing and harvesting.</p>
                        <a href="/crops/wheat">View Details<i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>

                </div>
            </div>


            <!-- Cotton -->

            <div class="col-md-6 col-lg-3">
                <div class="crop-card">
                    <div class="crop-image"><i class="fa-solid fa-seedling"></i></div>

                    <div class="crop-content">
                        <span class="crop-category">Kharif Crop</span>
                        <h3>Cotton</h3>
                        <p>Learn about cotton cultivation, irrigation and crop management.</p>
                        <a href="/crops/cotton">View Details<i class="fa-solid fa-arrow-right"></i></a>
                    </div>

                </div>
            </div>


            <!-- Soybean -->

            <div class="col-md-6 col-lg-3">
                <div class="crop-card">
                    <div class="crop-image"><i class="fa-solid fa-leaf"></i></div>

                    <div class="crop-content">
                        <span class="crop-category">Kharif Crop</span>
                        <h3>Soybean</h3>
                        <p>Understand soil preparation, sowing and irrigation requirements.</p>
                        <a href="/crops/soybean">View Details<i class="fa-solid fa-arrow-right"></i></a>
                    </div>

                </div>
            </div>


            <!-- Rice -->

            <div class="col-md-6 col-lg-3">

                <div class="crop-card">
                    <div class="crop-image"><i class="fa-solid fa-bowl-rice"></i></div>

                    <div class="crop-content">
                        <span class="crop-category">Kharif Crop</span>
                        <h3>Rice</h3>
                        <p>Explore rice cultivation, water management and harvesting.</p>
                        <a href="/crops/rice">View Details<i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>

            </div>
        </div>

        <div class="text-center mt-5">
            <a href="/crops" class="btn btn-success">View All Crops<i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>

</section>